[require]
GL ES >= 3.1
GLSL ES >= 3.10

[compute shader]
#version 310 es
precision highp int;

layout(local_size_x = 1) in;
layout(std430, binding = 0) readonly buffer Input {
    uint values[];
} input0;
layout(std430, binding = 1) buffer Output {
    uint values[];
} output0;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    output0.values[i] = input0.values[i] + 7u;
}

[test]
ssbo 0 16
ssbo 1 16
ssbo 0 subdata int 0 3
ssbo 0 subdata int 4 11
ssbo 0 subdata int 8 42
ssbo 0 subdata int 12 100
compute 4 1 1
probe ssbo uint 1 0 == 10
probe ssbo uint 1 4 == 18
probe ssbo uint 1 8 == 49
probe ssbo uint 1 12 == 107
