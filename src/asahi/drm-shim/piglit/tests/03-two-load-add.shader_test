[require]
GL ES >= 3.1
GLSL ES >= 3.10

[compute shader]
#version 310 es
precision highp int;

layout(local_size_x = 1) in;
layout(std430, binding = 0) readonly buffer InputA {
    uint values[];
} input_a;
layout(std430, binding = 1) readonly buffer InputB {
    uint values[];
} input_b;
layout(std430, binding = 2) buffer Output {
    uint values[];
} output0;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    output0.values[i] = input_a.values[i] + input_b.values[i];
}

[test]
ssbo 0 16
ssbo 1 16
ssbo 2 16
ssbo 0 subdata int 0 5
ssbo 0 subdata int 4 17
ssbo 0 subdata int 8 29
ssbo 0 subdata int 12 101
ssbo 1 subdata int 0 2
ssbo 1 subdata int 4 13
ssbo 1 subdata int 8 31
ssbo 1 subdata int 12 7
compute 4 1 1
probe ssbo uint 2 0 == 7
probe ssbo uint 2 4 == 30
probe ssbo uint 2 8 == 60
probe ssbo uint 2 12 == 108
