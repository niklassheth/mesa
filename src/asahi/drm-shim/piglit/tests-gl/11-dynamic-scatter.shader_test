[require]
GL >= 4.3
GLSL >= 4.30

[compute shader]
#version 430

layout(local_size_x = 1) in;
layout(std430, binding = 0) buffer Output {
    uint values[];
} output0;
layout(std430, binding = 1) readonly buffer Indices {
    uint values[];
} indices;
layout(std430, binding = 2) readonly buffer Data {
    uint values[];
} data;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint j = indices.values[i] & 7u;
    output0.values[j] = data.values[j] + i * 17u;
}

[test]
ssbo 0 32
ssbo 1 32
ssbo 2 32
ssbo 1 subdata int 0 5
ssbo 1 subdata int 4 2
ssbo 1 subdata int 8 7
ssbo 1 subdata int 12 0
ssbo 1 subdata int 16 6
ssbo 1 subdata int 20 3
ssbo 1 subdata int 24 1
ssbo 1 subdata int 28 4
ssbo 2 subdata int 0 101
ssbo 2 subdata int 4 211
ssbo 2 subdata int 8 307
ssbo 2 subdata int 12 401
ssbo 2 subdata int 16 503
ssbo 2 subdata int 20 601
ssbo 2 subdata int 24 701
ssbo 2 subdata int 28 809
compute 8 1 1
probe ssbo uint 0 0 == 152
probe ssbo uint 0 4 == 313
probe ssbo uint 0 8 == 324
probe ssbo uint 0 12 == 486
probe ssbo uint 0 16 == 622
probe ssbo uint 0 20 == 601
probe ssbo uint 0 24 == 769
probe ssbo uint 0 28 == 843
