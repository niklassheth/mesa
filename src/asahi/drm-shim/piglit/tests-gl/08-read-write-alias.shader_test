[require]
GL >= 4.3
GLSL >= 4.30

[compute shader]
#version 430

layout(local_size_x = 1) in;
layout(std430, binding = 0) buffer InOut {
    uint values[];
} inout0;
layout(std430, binding = 1) buffer Output {
    uint values[];
} output1;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint original = inout0.values[i];
    inout0.values[i] = original + 100u;
    output1.values[i] = original ^ 0xa5u;
}

[test]
ssbo 0 16
ssbo 1 16
ssbo 0 subdata int 0 7
ssbo 0 subdata int 4 18
ssbo 0 subdata int 8 52
ssbo 0 subdata int 12 129
compute 4 1 1
probe ssbo uint 0 0 == 107
probe ssbo uint 0 4 == 118
probe ssbo uint 0 8 == 152
probe ssbo uint 0 12 == 229
probe ssbo uint 1 0 == 162
probe ssbo uint 1 4 == 183
probe ssbo uint 1 8 == 145
probe ssbo uint 1 12 == 36
