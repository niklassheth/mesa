[require]
GL >= 3.3
GLSL >= 3.30
GL_ARB_compute_shader
GL_ARB_compute_variable_group_size
GL_ARB_shader_storage_buffer_object

[compute shader]
#version 330
#extension GL_ARB_compute_shader: require
#extension GL_ARB_compute_variable_group_size: require
#extension GL_ARB_shader_storage_buffer_object: require

layout(local_size_variable) in;

layout(std430, binding = 0) buffer Output {
    uint values[];
} output0;

void main()
{
    output0.values[0] = gl_NumWorkGroups.x;
    output0.values[1] = gl_NumWorkGroups.y;
    output0.values[2] = gl_NumWorkGroups.z;
    output0.values[3] = gl_LocalGroupSizeARB.x;
}

[test]
ssbo 0 16
compute group size 2 3 4 5 2 3
probe ssbo uint 0 0 == 2
probe ssbo uint 0 4 == 3
probe ssbo uint 0 8 == 4
probe ssbo uint 0 12 == 5
