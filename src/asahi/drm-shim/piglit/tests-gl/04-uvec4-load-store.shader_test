[require]
GL >= 4.3
GLSL >= 4.30

[compute shader]
#version 430

layout(local_size_x = 1) in;
layout(std430, binding = 0) readonly buffer Input {
    uvec4 values[];
} input0;
layout(std430, binding = 1) buffer Output {
    uvec4 values[];
} output0;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    output0.values[i] = input0.values[i];
}

[test]
ssbo 0 32
ssbo 1 32
ssbo 0 subdata int 0 1
ssbo 0 subdata int 4 3
ssbo 0 subdata int 8 5
ssbo 0 subdata int 12 7
ssbo 0 subdata int 16 11
ssbo 0 subdata int 20 13
ssbo 0 subdata int 24 17
ssbo 0 subdata int 28 19
compute 2 1 1
probe ssbo uint 1 0 == 1
probe ssbo uint 1 4 == 3
probe ssbo uint 1 8 == 5
probe ssbo uint 1 12 == 7
probe ssbo uint 1 16 == 11
probe ssbo uint 1 20 == 13
probe ssbo uint 1 24 == 17
probe ssbo uint 1 28 == 19
