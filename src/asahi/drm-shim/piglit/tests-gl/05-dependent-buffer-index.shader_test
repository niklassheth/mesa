[require]
GL >= 4.3
GLSL >= 4.30

[compute shader]
#version 430

layout(local_size_x = 1) in;
layout(std430, binding = 0) readonly buffer Indices {
    uint values[];
} indices;
layout(std430, binding = 1) readonly buffer Data {
    uint values[];
} data;
layout(std430, binding = 2) buffer Output {
    uint values[];
} output0;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint j = indices.values[i] & 7u;
    output0.values[i] = data.values[j] + i;
}

[test]
ssbo 0 16
ssbo 1 32
ssbo 2 16
ssbo 0 subdata int 0 3
ssbo 0 subdata int 4 0
ssbo 0 subdata int 8 5
ssbo 0 subdata int 12 2
ssbo 1 subdata int 0 10
ssbo 1 subdata int 4 20
ssbo 1 subdata int 8 30
ssbo 1 subdata int 12 40
ssbo 1 subdata int 16 50
ssbo 1 subdata int 20 60
ssbo 1 subdata int 24 70
ssbo 1 subdata int 28 80
compute 4 1 1
probe ssbo uint 2 0 == 40
probe ssbo uint 2 4 == 11
probe ssbo uint 2 8 == 62
probe ssbo uint 2 12 == 33
