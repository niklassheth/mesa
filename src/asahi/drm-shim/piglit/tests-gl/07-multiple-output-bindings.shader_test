[require]
GL >= 4.3
GLSL >= 4.30

[compute shader]
#version 430

layout(local_size_x = 1) in;
layout(std430, binding = 0) buffer OutputAdd {
    uint values[];
} output_add;
layout(std430, binding = 1) buffer OutputXor {
    uint values[];
} output_xor;
layout(std430, binding = 2) readonly buffer Input {
    uint values[];
} input0;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint value = input0.values[i];
    output_add.values[i] = value + 10u;
    output_xor.values[i] = value ^ 0x55u;
}

[test]
ssbo 0 16
ssbo 1 16
ssbo 2 16
ssbo 2 subdata int 0 3
ssbo 2 subdata int 4 17
ssbo 2 subdata int 8 42
ssbo 2 subdata int 12 100
compute 4 1 1
probe ssbo uint 0 0 == 13
probe ssbo uint 0 4 == 27
probe ssbo uint 0 8 == 52
probe ssbo uint 0 12 == 110
probe ssbo uint 1 0 == 86
probe ssbo uint 1 4 == 68
probe ssbo uint 1 8 == 127
probe ssbo uint 1 12 == 49
